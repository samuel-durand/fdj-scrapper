# Copier ce fichier en backend/.env et remplir les valeurs.

# Base MongoDB (la même que l'ancien backend Express : les comptes sont conservés)
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/loterie
# Nom de la base si l'URI n'en contient pas
MONGODB_DB=loterie

# Mêmes secrets que l'ancien backend => les sessions en cours restent valides
JWT_SECRET=changez-moi-minimum-32-caracteres
JWT_REFRESH_SECRET=changez-moi-aussi-minimum-32-caracteres
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

PORT=5000
# development | production
APP_ENV=development
# Origines autorisées (CORS), séparées par des virgules. Inutile si Flask sert aussi le front.
FRONTEND_URL=http://localhost:5173
# Servir le front compilé (dist/) depuis Flask : auto | true | false
SERVE_FRONTEND=auto
